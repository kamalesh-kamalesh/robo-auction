# ==============================================================================
# ROBO AUCTION SERVER ENVIRONMENT CONFIGURATION
# ==============================================================================
# Copy this file to .env and configure for local development or production hosting.
# ==============================================================================

# Application Environment
NODE_ENV=production
PORT=4000

# Host Security
# Change this to a secret passphrase for Host dashboard authentication
HOST_PASSCODE=host2026

# Supabase PostgreSQL Database Integration
# Get these from your Supabase Dashboard: Project Settings -> API
SUPABASE_URL=https://your-project-id.supabase.co
# Use service_role key for backend so RLS bypasses safely for server-side state writes
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-secret-key
# Optional Anon key (fallback)
SUPABASE_ANON_KEY=your-supabase-anon-key
TOURNAMENT_SESSION_ID=default-session

# Dynamic Cross-Origin Resource Sharing (CORS)
# Add your deployed Vercel frontend URL (e.g. https://robo-auction.vercel.app,http://localhost:5173)
# Set to '*' for open development
CORS_ORIGIN=*

# Production Storage & Snapshot Disaster Recovery
STORAGE_FILE_PATH=./data/auction-snapshot.json
# Whether to restore previous session state on server startup (true | false)
RESTORE_SNAPSHOT=true
# Whether to run automatic periodic snapshot saves to Supabase + Local backup
AUTO_SNAPSHOT=true
# Snapshot write frequency in milliseconds (default: 20000 = 20s)
SNAPSHOT_INTERVAL_MS=20000

# Demo Mode Protection
ALLOW_DEMO_MODE=false
