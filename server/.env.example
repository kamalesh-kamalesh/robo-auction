# ==============================================================================
# ROBO AUCTION SERVER ENVIRONMENT CONFIGURATION
# ==============================================================================
# Copy this file to .env and customize values for production deployment.
# NEVER commit the real .env file or production snapshots to a public repository!
# ==============================================================================

# Application Environment
NODE_ENV=production
PORT=4000

# Host Security
# Change this to a strong, secret passphrase before production deployment!
HOST_PASSCODE=your_production_secret_host_passcode

# Production Storage & Snapshot Configuration
# Path to local persistent snapshot JSON for crash recovery
STORAGE_FILE_PATH=./data/auction-snapshot.json

# Whether to restore previous session state on server startup (true | false)
# Set to 'false' for fresh tournament events.
RESTORE_SNAPSHOT=false

# Whether to run automatic periodic snapshot saves (true | false)
AUTO_SNAPSHOT=true

# Snapshot write frequency in milliseconds (default: 20000 = 20s)
SNAPSHOT_INTERVAL_MS=20000

# Demo Mode Protection
# Set to 'false' in production to disable the /api/demo endpoint and Socket RUN_DEMO
# so mock teams cannot accidentally overwrite real participant tournament data.
ALLOW_DEMO_MODE=false
