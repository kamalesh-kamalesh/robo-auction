# ==============================================================================
# ROBO AUCTION CLIENT ENVIRONMENT CONFIGURATION
# ==============================================================================
# Copy this file to .env or .env.production on Vercel
# ==============================================================================

# Backend WebSocket & REST Server URL
# In Local Dev: http://localhost:4000
# In Production (e.g. Render/Fly.io): https://robo-auction-server.onrender.com
VITE_SERVER_URL=http://localhost:4000
VITE_BACKEND_URL=http://localhost:4000

# Optional Supabase Integration for Direct Client Access / Realtime
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key
